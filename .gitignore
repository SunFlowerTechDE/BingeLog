# --- Node / Next.js ---
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
*.tsbuildinfo
.turbo/
coverage/
.eslintcache

# --- Environment ---
.env
.env.*
!.env.example

# --- Swift / Xcode ---
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.swiftpm/
# Swift Package Manager checkouts. Anchored to the iOS app: git on macOS
# matches ignore rules case-insensitively, and a bare `Packages/` here
# silently swallowed the entire `packages/` workspace.
/apps/ios/**/Packages/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# --- Python (pipeline) ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Pipeline data dumps (gross, nie eingecheckt) ---
packages/pipeline/data/
*.json.gz
*.jsonl
*.nt.bz2

# --- Supabase ---
# Ein Muster mit Schraegstrich ist am Repo-Wurzelverzeichnis verankert, also
# haette `supabase/.temp/` nur ein Verzeichnis ganz oben erfasst, nicht das
# in packages/db. Deshalb explizit ueberall.
.supabase/
**/supabase/.temp/
**/supabase/.branches/

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Editor ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
