# ►►► NUR VORLAGE (.env.example) — HIER NICHTS EINTRAGEN ◄◄◄
# Diese Datei liegt im Repo. Echte Schluessel gehoeren niemals hier hinein.
#
# packages/db — migrations and the REST-level RLS tests.
# Copy to .env and fill in. .env is gitignored, this file is not.

# Settings -> General -> Reference ID (also the subdomain of the URL).
SUPABASE_PROJECT_REF=

# Settings -> Data API -> Project URL.
SUPABASE_URL=

# Settings -> API Keys -> publishable key (or the legacy anon key).
# Public by design: this is what the browser ships with.
SUPABASE_ANON_KEY=

# Settings -> API Keys -> secret key (or the legacy service_role key).
# Full access, bypasses RLS. Only this workspace and packages/pipeline
# ever see it, never apps/web (M0 0.2).
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> Database -> Connection string -> URI (session pooler is
# fine). Contains the database password. Used by `pnpm verify` only.
SUPABASE_DB_URL=

# Optional: lets `supabase link` and `supabase db push` run without
# prompting for the database password.
SUPABASE_DB_PASSWORD=
