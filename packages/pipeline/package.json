{
  "name": "@binge-log/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "import:wikidata": "node --experimental-strip-types --env-file=.env src/wikidata/import.ts",
    "artwork:tvdb": "node --experimental-strip-types --env-file=.env src/tvdb/run.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "subclasses": "node scripts/fetch-film-subclasses.mjs"
  },
  "dependencies": {
    "@binge-log/db": "workspace:*",
    "@supabase/supabase-js": "^2.58.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "typescript": "^5.9.2"
  }
}
