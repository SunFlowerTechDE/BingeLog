# ►►► NUR VORLAGE (.env.example) — HIER NICHTS EINTRAGEN ◄◄◄
# Diese Datei liegt im Repo. Echte Schluessel gehoeren niemals hier hinein.
#
# packages/pipeline — the only workspace that writes the catalog.
# Copy to .env and fill in. Runs offline, never part of a deployment.

# Settings -> Data API -> Project URL.
SUPABASE_URL=

# Settings -> API Keys -> secret key (or the legacy service_role key).
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> Database -> Connection string -> URI (session pooler).
# Der Artwork-Batch schreibt direkt per SQL in den Katalog; die Pipeline
# ist der einzige Workspace, der das darf.
SUPABASE_DB_URL=

# M2.2 onwards. TheTVDB supplies artwork only, never metadata (ADR-002).
TVDB_API_KEY=
TVDB_PIN=
