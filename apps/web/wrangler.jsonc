{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Zwei Worker, nicht einer mit zwei Adressen.
  //
  // Der Standard ist die Testumgebung: `cf:deploy` ohne weiteres Zutun
  // geht auf workers.dev und nie auf bingelog.eu. Die Hauptseite braucht
  // den ausdruecklichen Griff zu `cf:deploy:prod`. Wer sich vertippt,
  // veroeffentlicht auf dem Testserver — nicht umgekehrt.
  //
  // Dass der unbenannte Worker die Testumgebung ist und die Hauptseite
  // den Zusatz traegt, ist bewusst so herum: die Adresse
  // bingelog-web.binge-log-web.workers.dev leitet sich aus dem Namen ab,
  // und genau die ist die eingespielte Arbeitsadresse.
  "name": "bingelog-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // Next.js needs Node built-ins; without this the Worker cannot even boot.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Beide Werte sind oeffentlich: sie landen ohnehin im Client-Bundle.
  // Der Secret Key hat hier nichts zu suchen und wuerde vom
  // ESLint-Config des Web-Workspaces auch abgelehnt.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://rbgofrgstnotgpnnvehb.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_PfHdHB-vjXhNwAE7xTDgIw_ysnWn5Jm",
    // Oeffentlich, steht im Quelltext der Seite. Der zugehoerige
    // TURNSTILE_SECRET ist ein Secret und steht nicht hier.
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEfz-jXb5Hbs761s",
  },
  // Die Testumgebung haengt an keiner Domain.
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },

  "env": {
    "production": {
      "name": "bingelog-web-prod",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      // Ohne diese Bindung nimmt Cloudflare die Anfrage fuer die Domain
      // zwar an, sucht dann aber einen Ursprungsserver, den es nicht
      // gibt: 521. Cloudflare legt die DNS-Eintraege selbst an und
      // weigert sich, solange eigene Eintraege fuer den Namen bestehen.
      "routes": [
        { "pattern": "bingelog.eu", "custom_domain": true },
        { "pattern": "www.bingelog.eu", "custom_domain": true },
      ],
      // Kein workers.dev fuer die Hauptseite: sie ist unter ihrer Domain
      // erreichbar und sonst nirgends.
      "workers_dev": false,
      // Umgebungen erben `vars` nicht, sie muessen hier wiederholt
      // stehen. Fehlen sie, startet der Worker und faellt erst beim
      // ersten Zugriff auf Supabase um.
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://rbgofrgstnotgpnnvehb.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_PfHdHB-vjXhNwAE7xTDgIw_ysnWn5Jm",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEfz-jXb5Hbs761s",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
